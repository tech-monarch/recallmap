# Placeholders only. Copy to .env.local. Never commit real values.
# The UI runs without an API URL; authentication requests then report that no
# backend is connected. Configure the frontend auth API here when it is ready.

# --- Frontend authentication API ---
NEXT_PUBLIC_API_BASE_URL=
# Endpoint paths default to the documented contract in docs/API_CONTRACTS.md.
# Override only when the backend uses different paths.
NEXT_PUBLIC_AUTH_SIGN_IN_PATH=/api/auth/sign-in
NEXT_PUBLIC_AUTH_SIGN_UP_PATH=/api/auth/sign-up
NEXT_PUBLIC_AUTH_FORGOT_PASSWORD_PATH=/api/auth/password/forgot
NEXT_PUBLIC_AUTH_RESET_PASSWORD_PATH=/api/auth/password/reset
NEXT_PUBLIC_AUTH_GOOGLE_PATH=/api/auth/google

# --- Gemini (server-side only; never NEXT_PUBLIC_) ---
GEMINI_API_KEY_PRIMARY=your-primary-gemini-key
GEMINI_API_KEY_SECONDARY=your-secondary-gemini-key-from-separate-account
GEMINI_MODEL=verify-current-model-name

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/recallmap

# --- Authentication (Google OAuth via the backend) ---
AUTH_SECRET=generate-a-long-random-string
AUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
AUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
APP_BASE_URL=http://localhost:3000

# --- File storage (behind a configurable interface) ---
STORAGE_PROVIDER=local            # local | s3
STORAGE_LOCAL_DIR=./.storage      # used when STORAGE_PROVIDER=local
# S3-compatible (only if STORAGE_PROVIDER=s3)
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
