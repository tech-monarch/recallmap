# RecallMap environment template. Placeholders only: copy to .env.local and fill in. Never commit real values.
# Validated at startup by src/server/platform/config.ts (Zod). Empty values count as unset.
# Docs: docs/ENVIRONMENT_SETUP.md and docs/deployment/SETUP_GUIDE.md

# --- Environment -------------------------------------------------------------------------------
APP_ENV=local                 # local | cloud-dev | production
LOG_LEVEL=info                # debug | info | warn | error | silent

# --- Database (PostgreSQL) -----------------------------------------------------------------------
# Direct connection. Aiven example: postgres://USER:PASSWORD@HOST:PORT/recallmap_dev?sslmode=require
DATABASE_URL=postgres://recallmap:recallmap@localhost:5432/recallmap_dev
# Optional pooled URL for a plan that offers pooling (the free plan does not). The API prefers it when set.
DATABASE_POOLED_URL=
# Aiven free plan: 20 connections, about 17 usable. Pool sizes are checked against this budget at startup.
DB_CONNECTION_BUDGET=17
DB_POOL_MAX_API=5
DB_POOL_MAX_WORKER=2
PGBOSS_POOL_MAX=3
# Used only by `npm run test:db`. The database NAME MUST CONTAIN "test": the suite drops everything in it.
TEST_DATABASE_URL=postgres://recallmap:recallmap@localhost:5432/recallmap_test
# Optional admin URL for migrations (defaults to DATABASE_URL): npm run db:migrate
MIGRATION_DATABASE_URL=

# --- Background worker -------------------------------------------------------------------------
# off: web only (default). embedded: worker inside the web process while it is awake (Render free tier,
# development only, NOT production background processing). standalone is started with `npm run worker`.
WORKER_MODE=off
WORKER_CONSUMERS=2
WORKER_SHUTDOWN_TIMEOUT_MS=25000

# --- AI (server-side only; never NEXT_PUBLIC_) ---------------------------------------------------
# synthetic: learner-derived prompts are refused (DR-18). real: production only, needs an approval reference.
AI_DATA_MODE=synthetic
AI_REAL_DATA_APPROVAL_REF=
GEMINI_API_KEY_PRIMARY=
GEMINI_PRIMARY_ENABLED=true
# Another person's key: leave unset and disabled until gates G1-G6 pass (docs/compliance/THIRD_PARTY_PROCESSORS.md).
GEMINI_API_KEY_SECONDARY=
GEMINI_SECONDARY_ENABLED=false

# --- Sessions ----------------------------------------------------------------------------------
# At least 32 random characters. Required when APP_ENV=production. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_ABSOLUTE_TTL_HOURS=336
SESSION_IDLE_TTL_HOURS=168

# --- Development limits (protect the small free instance) ------------------------------------------
DEV_MAX_UPLOAD_MB=5
DEV_MAX_PAGES=20

# --- Legacy frontend auth (parked email/password screens, out of launch scope, see DR-11) ----------------
# The UI runs without an API URL; those screens then report that no backend is connected.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTH_SIGN_IN_PATH=/api/auth/sign-in
NEXT_PUBLIC_AUTH_SIGN_UP_PATH=/api/auth/sign-up
NEXT_PUBLIC_AUTH_FORGOT_PASSWORD_PATH=/api/auth/password/forgot
NEXT_PUBLIC_AUTH_RESET_PASSWORD_PATH=/api/auth/password/reset
NEXT_PUBLIC_AUTH_GOOGLE_PATH=/api/auth/google
